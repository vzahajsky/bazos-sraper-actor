{
    "title": "Bazos.cz crawler input schema",
    "description": "",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "countryCode": {
            "title": "Country code",
            "type": "string",
            "description": "Select country to use",
            "editor": "select",
            "default": "cz",
            "enum": ["cz", "sk"],
            "enumTitles": ["CZ", "SK"]
        },
        "searchQueries": {
            "title": "Search queries",
            "type": "array",
            "description": "Search queries to search and merge results in one run",
            "prefill": [
                "bmw 1200gs",
                "1200 gs"
            ],
            "editor": "stringList",
            "maxItems": 5,
            "uniqueItems": true
        },
        "minPrice": {
            "title": "Price from",
            "type": "integer",
            "description": "Lowest price",
            "editor": "number",
            "nullable": true
        },
        "maxPrice": {
            "title": "Price to",
            "type": "integer",
            "description": "Highest price",
            "editor": "number",
            "nullable": true
        },
        "postalCode": {
            "title": "Postal code",
            "type": "integer",
            "description": "Postal code of area where to search.",
            "editor": "number",
            "nullable": true
        },
        "distance": {
            "title": "Price to",
            "type": "integer",
            "description": "The size of the circle in which to look.",
            "editor": "number",
            "minimum": 26,
            "nullable": true
        },
        "maxRequestsPerCrawl": {
            "title": "Max Requests per Crawl",
            "type": "integer",
            "description": "Approximate number of how many ads you want to load.",
            "default": 100
        },
        "bid": {
            "title": "Bazos User ID (bid)",
            "type": "string",
            "description": "Manual cookie: Bazos user ID (8-digit number). Required for phone extraction. Get it from browser console using the script in README.",
            "editor": "textfield",
            "example": "79580379"
        },
        "bkod": {
            "title": "Bazos Auth Token (bkod)",
            "type": "string",
            "description": "Manual cookie: Authentication token (10-char alphanumeric). Required for phone extraction. Get it from browser console using the script in README.",
            "editor": "textfield",
            "isSecret": true,
            "example": "HCIIFBA50J"
        },
        "testcookie": {
            "title": "Test Cookie",
            "type": "string",
            "description": "Manual cookie: Feature flag (default: 'ano'). Usually not needed to change.",
            "editor": "textfield",
            "default": "ano"
        },
        "testCookiesBeforeRun": {
            "title": "Test cookies before run",
            "type": "boolean",
            "description": "Test cookies validity before starting the scraper (recommended)",
            "default": true
        },
        "enableAutoVerification": {
            "title": "Enable automatic phone verification (NOT IMPLEMENTED)",
            "type": "boolean",
            "description": "NOT FULLY IMPLEMENTED - requires real API integration. Use manual cookies (bid, bkod) instead.",
            "default": false
        },
        "phoneServiceConfig": {
            "title": "Phone service configuration (NOT IMPLEMENTED)",
            "type": "object",
            "description": "NOT FULLY IMPLEMENTED - External service integration pending. Use manual cookies instead.",
            "editor": "json",
            "properties": {
                "provider": {
                    "title": "Provider",
                    "type": "string",
                    "description": "Phone service provider",
                    "enum": ["sms-activate", "5sim", "custom"],
                    "default": "sms-activate"
                },
                "apiKey": {
                    "title": "API Key",
                    "type": "string",
                    "description": "API key from provider",
                    "editor": "textfield",
                    "isSecret": true
                },
                "apiUrl": {
                    "title": "API URL",
                    "type": "string",
                    "description": "Provider API endpoint",
                    "editor": "textfield",
                    "default": "https://api.sms-activate.org/stubs/handler_api.php"
                }
            }
        },
        "smsServiceConfig": {
            "title": "SMS service configuration (NOT IMPLEMENTED)",
            "type": "object",
            "description": "NOT FULLY IMPLEMENTED - External service integration pending. Use manual cookies instead.",
            "editor": "json",
            "properties": {
                "provider": {
                    "title": "Provider",
                    "type": "string",
                    "description": "SMS service provider",
                    "enum": ["sms-activate", "5sim", "custom"],
                    "default": "sms-activate"
                },
                "apiKey": {
                    "title": "API Key",
                    "type": "string",
                    "description": "API key from provider",
                    "editor": "textfield",
                    "isSecret": true
                },
                "apiUrl": {
                    "title": "API URL",
                    "type": "string",
                    "description": "Provider API endpoint",
                    "editor": "textfield",
                    "default": "https://api.sms-activate.org/stubs/handler_api.php"
                }
            }
        }
    },
    "required": [
        "searchQueries"
    ]
}
